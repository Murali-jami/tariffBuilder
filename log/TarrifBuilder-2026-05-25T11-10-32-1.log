    a.tariff_package_id,
    a.tariff_package_desc,
    b.activation_fee,

    DECODE(
        rental_type,
        'M', 'Monthly',
        'O', 'Others',
        'D', 'Daily',
        'W', 'Weekly',
        'F', 'Fixed',
        'U', 'Unlimited',
        'Y', 'Yearly'
    ) rental_type,

    f.balance_category,

    CASE
        WHEN f.balance_category = 'DATA'
        THEN CASE
                WHEN SUM(f.bucket_unit_value) > 99999
                THEN 'UNLIMITED'
                ELSE fn_data_unit_converter(SUM(f.bucket_unit_value))
             END

        WHEN f.balance_category = 'SMS'
        THEN SUM(f.bucket_unit_value) || ' SMS'

        WHEN f.balance_category = 'VOICE'
        THEN SUM(f.bucket_unit_value) || ' Sec'

        WHEN f.balance_category = 'GLOBAL'
        THEN SUM(f.bucket_unit_value) || ' Amt'
    END bucket_unit_value,

    rg.rate_group_name

FROM cs_rat_tariff_package a
JOIN cs_rat_periodic_charge_info b
    ON a.charge_id = b.charge_id

JOIN cs_rat_tariff_service_pack_map c
    ON a.tariff_package_id = c.tariff_package_id

JOIN cs_atp_accumu_bon_disc_map d
    ON c.service_package_id = d.atp_id

JOIN cs_bndl_mt_bndl_bucket_map e
    ON d.bundle_or_discount_id = e.bundle_id

JOIN bndl_mt_buckets f
    ON e.bucket_id = f.bucket_id

/* RATE GROUP QUERY JOIN */

LEFT JOIN cs_rat_service_plan_package spp
    ON c.service_package_id = spp.service_package_id

LEFT JOIN cs_rat_service_plans sp
    ON spp.service_plan_id = sp.service_plan_id

LEFT JOIN cs_dre_rating_group_details rgd
    ON sp.zone_group_id = rgd.zone_group_id

LEFT JOIN cs_rate_group_data rg
    ON rg.rate_group_id = rgd.rating_group_id

WHERE a.network_id = ?
AND c.network_id = ?
AND a.tariff_plan_type = 'DATP'

GROUP BY
    a.tariff_package_id,
    a.tariff_package_desc,
    b.activation_fee,
    rental_type,
    f.balance_category,
    rg.rate_group_name

ORDER BY b.activation_fee DESC
